<Project>
  <PropertyGroup>
    <!-- Bump major.minor here; the pipeline stamps the patch with the workflow run number (-p:BuildNumber=N). -->
    <VersionMajorMinor>0.1</VersionMajorMinor>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Version>$(VersionMajorMinor).$(BuildNumber)</Version>
    <!-- Keep the displayed version clean (no +commit-hash suffix). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
